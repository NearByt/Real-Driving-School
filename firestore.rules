rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ========================================================================
    // Real Driving School Hub - Real-Time Zero-Budget Cloud Rules
    // Enables multi-device real-time sync for vehicles, tuning specs, events,
    // updates, multiplayer guides, active sessions, and live UI customization.
    // ========================================================================

    // Hub Data Collections (cars, tyres, events, updates, rules, maps, multiplayer, admins, roles, config, logs)
    match /rds_hub/{document=**} {
      allow read, write: if true;
    }

    // Live Active Sessions (heartbeat & active drivers tracker)
    match /rds_sessions/{sessionId} {
      allow read, write: if true;
    }

    // Default catch-all for any additional sub-collections
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
